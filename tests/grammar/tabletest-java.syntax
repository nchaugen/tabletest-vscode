// SYNTAX TEST "tabletest.injection" "TableTest Java"
class Sample {
  @TableTest(
    """
    a | "b" | 'c'
//  ^ meta.tabletest.header
//  ^ markup.heading.tabletest
//  ^ entity.name.column.tabletest
//    ^ keyword.operator.tabletest.pipe
//      ^ string.quoted.double.tabletest
//          ^ keyword.operator.tabletest.pipe
//            ^ string.quoted.single.tabletest
    [1, 2] | {x, y} | [k: v]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.list
//             ^ meta.tabletest.set
//                       ^ meta.tabletest.map
//                     ^ support.type.property-name.tabletest
    [x: [1, 2]]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//      ^ meta.tabletest.list
//        ^ punctuation.separator.comma.tabletest
    // table comment
//  ^ comment.line.double-slash.tabletest
    """,
    other = "not a table"
  )
  void testSomething() {}
}

class SameLineStart {
  @TableTest("""
    a | b
//    ^ keyword.operator.tabletest.pipe
    """)
  void testSameLineStart() {}
}

class ValueArgument {
  @TableTest(other = "ignore", value = """
    a | b
//    ^ keyword.operator.tabletest.pipe
    """, another = "123")
  void testValueArgument() {}
}

class EscapedTerminator {
  @TableTest("""
    a | \""" | b
//    ^ keyword.operator.tabletest.pipe
//           ^ keyword.operator.tabletest.pipe
    c | d
//    ^ keyword.operator.tabletest.pipe
    """)
  void testEscapedTerminator() {}
}

class SameLineClose {
  @TableTest("""
    a | b """
//    ^ keyword.operator.tabletest.pipe
  )
  void testSameLineClose() {}
}

class CommentBeforeImplicitValue {
  @TableTest(
    // comment before value
    """
    left | right
//       ^ keyword.operator.tabletest.pipe
    """
  )
  void testCommentBeforeImplicitValue() {}
}

class MultipleArgsWithNamedValue {
  @TableTest(
    name = "custom name",
    value = """
    one | two
//      ^ keyword.operator.tabletest.pipe
    """
  )
  void testMultipleArgsWithNamedValue() {}
}

class StringArrayImplicitValue {
  @TableTest({
    "name|age",
//   ^ markup.heading.tabletest
//   ^ meta.tabletest.header
//       ^ keyword.operator.tabletest.pipe
    "Alice|30"
//   ^ meta.tabletest.row
//   ^ - markup.heading.tabletest
//        ^ keyword.operator.tabletest.pipe
  })
  void testStringArrayImplicitValue() {}
}

class StringArrayNamedValue {
  @TableTest(value = {
    "left|right",
//   ^ markup.heading.tabletest
//   ^ meta.tabletest.header
//       ^ keyword.operator.tabletest.pipe
    "[x: [1,2]]|ok"
//   ^ meta.tabletest.row
//   ^ - markup.heading.tabletest
//   ^ meta.tabletest.map
//       ^ meta.tabletest.list
//             ^ keyword.operator.tabletest.pipe
    "[1, 2]|{x, y}|[k: v]"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.list
//          ^ meta.tabletest.set
//                 ^ meta.tabletest.map
    "[1, 2] | {x, y} | [k: v]"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.list
//            ^ meta.tabletest.set
//                      ^ meta.tabletest.map
  }, name = "x")
  void testStringArrayNamedValue() {}
}

class NonTableArrayAnnotation {
  @Other({"a|b"})
//          ^ - keyword.operator.tabletest.pipe
  void testNonTableArrayAnnotation() {}
}

class FullyQualifiedTableTestAnnotation {
  @org.tabletest.junit.TableTest({
    "col1|col2",
//   ^ markup.heading.tabletest
//   ^ meta.tabletest.header
//       ^ keyword.operator.tabletest.pipe
    "[1, 2]|{x, y}|[k: v]"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.list
//          ^ meta.tabletest.set
//                 ^ meta.tabletest.map
  })
  void testFullyQualifiedTableTestAnnotation() {}
}
