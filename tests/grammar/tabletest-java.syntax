// SYNTAX TEST "tabletest.injection" "TableTest Java"
class Sample {
  @TableTest(
    """
    a | "b" | 'c'
//  ^ meta.tabletest.header
//  ^ entity.name.type.tabletest.probe.header
//  ^ entity.name.column.tabletest
//    ^ punctuation.separator.pipe.tabletest
//      ^ constant.numeric.tabletest.quote
//          ^ punctuation.separator.pipe.tabletest
//            ^ constant.numeric.tabletest.quote
    [1, 2] | {x, y} | [k: v]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.list
//             ^ meta.tabletest.set
//                       ^ meta.tabletest.map
//                     ^ keyword.control.tabletest
    [x: [1, 2]]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//      ^ meta.tabletest.list
//        ^ constant.numeric.tabletest.separator
    ["key with spaces": value]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//    ^ keyword.control.tabletest
    is not empty  | ["(s)u[c]c{e}ss": false]
//  ^ meta.tabletest.row
//                    ^ keyword.control.tabletest
//                        ^ keyword.control.tabletest
//                        ^ - punctuation.section.brackets.begin.tabletest
//                            ^ keyword.control.tabletest
//                            ^ - punctuation.section.braces.begin.tabletest
    has size      | ['[s]u(c)c{e}s[s': 3]
//  ^ meta.tabletest.row
//                    ^ keyword.control.tabletest
//                    ^ - punctuation.section.brackets.begin.tabletest
//                        ^ keyword.control.tabletest
//                            ^ keyword.control.tabletest
//                            ^ - punctuation.section.braces.begin.tabletest
    "" | ''
//  ^ meta.tabletest.row
//  ^ constant.numeric.tabletest.quote
//       ^ constant.numeric.tabletest.quote
    // table comment
//  ^ comment.line.double-slash.tabletest
    """,
    other = "not a table"
  )
  void testSomething() {}
}

class SameLineStart {
  @TableTest("""
    a | b
//    ^ punctuation.separator.pipe.tabletest
    """)
  void testSameLineStart() {}
}

class ValueArgument {
  @TableTest(other = "ignore", value = """
    a | b
//    ^ punctuation.separator.pipe.tabletest
    """, another = "123")
  void testValueArgument() {}
}

class EscapedTerminator {
  @TableTest("""
    a | \""" | b
//    ^ punctuation.separator.pipe.tabletest
//           ^ punctuation.separator.pipe.tabletest
    c | d
//    ^ punctuation.separator.pipe.tabletest
    """)
  void testEscapedTerminator() {}
}

class SameLineClose {
  @TableTest("""
    a | b """
//    ^ punctuation.separator.pipe.tabletest
  )
  void testSameLineClose() {}
}

class CommentBeforeImplicitValue {
  @TableTest(
    // comment before value
    """
    left | right
//       ^ punctuation.separator.pipe.tabletest
    """
  )
  void testCommentBeforeImplicitValue() {}
}

class LeadingCommentBeforeHeader {
  @TableTest(
    """
    // leading table comment
//  ^ comment.line.double-slash.tabletest
    scenario | result?
//  ^ entity.name.type.tabletest.probe.header
//  ^ meta.tabletest.header
//  ^ entity.name.column.tabletest
//           ^ punctuation.separator.pipe.tabletest
    one      | ok
//  ^ meta.tabletest.row
    """
  )
  void testLeadingCommentBeforeHeader() {}
}

class StringArrayLeadingCommentBeforeHeader {
  @TableTest({
    "// leading array comment",
//   ^ comment.line.double-slash.tabletest
    "scenario|result?",
//   ^ entity.name.type.tabletest.probe.header
//   ^ meta.tabletest.header
//           ^ punctuation.separator.pipe.tabletest
    "one|ok"
//   ^ meta.tabletest.row
  })
  void testStringArrayLeadingCommentBeforeHeader() {}
}

class MultipleArgsWithNamedValue {
  @TableTest(
    name = "custom name",
    value = """
    one | two
//      ^ punctuation.separator.pipe.tabletest
    """
  )
  void testMultipleArgsWithNamedValue() {}
}

class StringArrayImplicitValue {
  @TableTest({
    "name|age",
//   ^ entity.name.type.tabletest.probe.header
//   ^ meta.tabletest.header
//       ^ punctuation.separator.pipe.tabletest
    "Alice|30"
//   ^ meta.tabletest.row
//   ^ - entity.name.type.tabletest.probe.header
//        ^ punctuation.separator.pipe.tabletest
  })
  void testStringArrayImplicitValue() {}
}

class StringArrayNamedValue {
  @TableTest(value = {
    "left|right",
//   ^ entity.name.type.tabletest.probe.header
//   ^ meta.tabletest.header
//       ^ punctuation.separator.pipe.tabletest
    "[x: [1,2]]|ok"
//   ^ meta.tabletest.row
//   ^ - entity.name.type.tabletest.probe.header
//   ^ meta.tabletest.map
//       ^ meta.tabletest.list
//             ^ punctuation.separator.pipe.tabletest
    "[1, 2]|{x, y}|[k: v]"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.list
//          ^ meta.tabletest.set
//                 ^ meta.tabletest.map
    "[1, 2] | {x, y} | [k: v]"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.list
//            ^ meta.tabletest.set
//                      ^ meta.tabletest.map
    "[\"[a]\": 1]|ok"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.map
//       ^ keyword.control.tabletest
    "     [\"[a]\": 1, '{b}': 2, \"(c)\": 3]|ok"
//   ^ meta.tabletest.row
//            ^ keyword.control.tabletest
//                       ^ keyword.control.tabletest
//                                  ^ keyword.control.tabletest
  }, name = "x")
  void testStringArrayNamedValue() {}
}

class NonTableArrayAnnotation {
  @Other({"a|b"})
//          ^ - punctuation.separator.pipe.tabletest
  void testNonTableArrayAnnotation() {}
}

class SimilarAnnotationName {
  @TableTestX({"a|b"})
//               ^ - punctuation.separator.pipe.tabletest
