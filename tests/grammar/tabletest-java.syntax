    "[1, 2]|{x, y}|[k: v]"
//   ^ meta.tabletest.row
//   ^ meta.tabletest.list
//          ^ meta.tabletest.set
//                 ^ meta.tabletest.map
  })
  void testFullyQualifiedTableTestAnnotation() {}
}

class StringArrayEscapedContent {
  @TableTest({
    "scenario|scalar|list|map",
//   ^ entity.name.type.tabletest.probe.header
    "  // middle comment after header",
//     ^ comment.line.double-slash.tabletest
    "quoted|\"x\"|[a, \"A,B\"]|[\"(s)u[c]c{e}ss\": false]"
//   ^ meta.tabletest.row
//          ^ constant.numeric.tabletest.quote
//                    ^ constant.numeric.tabletest.quote
//                              ^ constant.numeric.tabletest.quote
  })
  void testStringArrayEscapedContent() {}
//^ - string.unquoted.tabletest
