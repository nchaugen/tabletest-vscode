// SYNTAX TEST "tabletest.kotlin.injection" "TableTest Kotlin"
class Sample {
  @TableTest(
    """
    a | "b" | 'c'
//  ^ meta.tabletest.header
//  ^ entity.name.type.tabletest.probe.header
//  ^ entity.name.column.tabletest
//    ^ punctuation.separator.pipe.tabletest
//      ^ constant.numeric.tabletest.quote
//          ^ punctuation.separator.pipe.tabletest
//            ^ constant.numeric.tabletest.quote
    [1, 2] | {x, y} | [k: v]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.list
//             ^ meta.tabletest.set
//                       ^ meta.tabletest.map
//                     ^ keyword.control.tabletest
    [x: [1, 2]]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//      ^ meta.tabletest.list
//        ^ constant.numeric.tabletest.separator
    ["key with spaces": value]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//    ^ keyword.control.tabletest
    ['[a]': b]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//    ^ keyword.control.tabletest
    ["[a]": 1, '{b}': 2, "(c)": 3]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//    ^ keyword.control.tabletest
//    ^ - punctuation.section.brackets.begin.tabletest
//              ^ keyword.control.tabletest
//              ^ - punctuation.section.braces.begin.tabletest
//                         ^ keyword.control.tabletest
    "" | ''
//  ^ meta.tabletest.row
//  ^ constant.numeric.tabletest.quote
//       ^ constant.numeric.tabletest.quote
    // table comment
//  ^ comment.line.double-slash.tabletest
    """,
    other = "not a table"
  )
  fun testSomething() {}
}

class SameLineStart {
  @TableTest("""
    a | b
//    ^ punctuation.separator.pipe.tabletest
    """)
  fun testSameLineStart() {}
}

class ValueArgument {
  @TableTest(other = "ignore", value = """
    a | b
//    ^ punctuation.separator.pipe.tabletest
    """, another = "123")
  fun testValueArgument() {}
}

class EscapedTerminator {
  @TableTest("""
    a | \""" | b
//    ^ punctuation.separator.pipe.tabletest
//           ^ - punctuation.separator.pipe.tabletest
    c | d
//    ^ - punctuation.separator.pipe.tabletest
    """)
  fun testEscapedTerminator() {}
}

class SameLineClose {
  @TableTest("""
    a | b """
//    ^ punctuation.separator.pipe.tabletest
  )
  fun testSameLineClose() {}
}

class CommentBeforeImplicitValue {
  @TableTest(
    // comment before value
    """
    left | right
//       ^ punctuation.separator.pipe.tabletest
    """
  )
  fun testCommentBeforeImplicitValue() {}
}

class LeadingCommentBeforeHeader {
  @TableTest(
    """
    // leading table comment
//  ^ comment.line.double-slash.tabletest
    """
  )
  fun testLeadingCommentBeforeHeader() {}
}

class MultipleArgsWithNamedValue {
  @TableTest(
    name = "custom name",
    value = """
    one | two
//      ^ punctuation.separator.pipe.tabletest
    """
  )
  fun testMultipleArgsWithNamedValue() {}
}

class SimilarAnnotationName {
  @TableTestX("""
    a | b
//    ^ - punctuation.separator.pipe.tabletest
    """)
  fun testSimilarAnnotationName() {}
}

class FullyQualifiedAnnotation {
  @org.tabletest.junit.TableTest("""
    a | b
//    ^ - punctuation.separator.pipe.tabletest
    """)
  fun testFullyQualifiedAnnotation() {}
}
