// SYNTAX TEST "tabletest.kotlin.injection" "TableTest Kotlin"
class Sample {
  @TableTest(
    """
    a | "b" | 'c'
//  ^ meta.tabletest.header
//  ^ markup.heading.tabletest
//  ^ entity.name.column.tabletest
//    ^ keyword.operator.tabletest.pipe
//      ^ string.quoted.double.tabletest
//          ^ keyword.operator.tabletest.pipe
//            ^ string.quoted.single.tabletest
    [1, 2] | {x, y} | [k: v]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.list
//             ^ meta.tabletest.set
//                       ^ meta.tabletest.map
//                     ^ support.type.property-name.tabletest
    [x: [1, 2]]
//  ^ meta.tabletest.row
//  ^ meta.tabletest.map
//      ^ meta.tabletest.list
//        ^ punctuation.separator.comma.tabletest
    // table comment
//  ^ comment.line.double-slash.tabletest
    """,
    other = "not a table"
  )
  fun testSomething() {}
}

class SameLineStart {
  @TableTest("""
    a | b
//    ^ keyword.operator.tabletest.pipe
    """)
  fun testSameLineStart() {}
}

class ValueArgument {
  @TableTest(other = "ignore", value = """
    a | b
//    ^ keyword.operator.tabletest.pipe
    """, another = "123")
  fun testValueArgument() {}
}

class EscapedTerminator {
  @TableTest("""
    a | \""" | b
//    ^ keyword.operator.tabletest.pipe
//           ^ - keyword.operator.tabletest.pipe
    c | d
//    ^ - keyword.operator.tabletest.pipe
    """)
  fun testEscapedTerminator() {}
}

class SameLineClose {
  @TableTest("""
    a | b """
//    ^ keyword.operator.tabletest.pipe
  )
  fun testSameLineClose() {}
}

class CommentBeforeImplicitValue {
  @TableTest(
    // comment before value
    """
    left | right
//       ^ keyword.operator.tabletest.pipe
    """
  )
  fun testCommentBeforeImplicitValue() {}
}

class MultipleArgsWithNamedValue {
  @TableTest(
    name = "custom name",
    value = """
    one | two
//      ^ keyword.operator.tabletest.pipe
    """
  )
  fun testMultipleArgsWithNamedValue() {}
}
