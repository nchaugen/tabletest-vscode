{
  "scopeName": "source.tabletest",
  "name": "TableTest",
  "patterns": [
    { "include": "#table" }
  ],
  "repository": {
    "table": {
      "patterns": [
        { "include": "#tableHeaderRow" },
        { "include": "#tableRow" }
      ]
    },
    "tableHeaderRow": {
      "name": "meta.tabletest.header",
      "begin": "\\A",
      "end": "$",
      "patterns": [
        { "include": "#tableHeaderCell" }
      ]
    },
    "tableRow": {
      "name": "meta.tabletest.row",
      "begin": "^",
      "end": "$",
      "patterns": [
        { "include": "#tableCell" }
      ]
    },
    "tableCell": {
      "begin": "(^|\\|)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.pipe.tabletest"
        }
      },
      "end": "(?=\\|)|$",
      "patterns": [
        { "name": "comment.line.double-slash.tabletest", "match": "//.*$" },
        { "include": "#stringDouble" },
        { "include": "#stringSingle" },
        { "include": "#mapLiteral" },
        { "include": "#listLiteral" },
        { "include": "#setLiteral" },
        { "name": "string.unquoted.tabletest", "match": "[^|\\r\\n]+" }
      ]
    },
    "tableHeaderCell": {
      "begin": "(^|\\|)\\s*",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.pipe.tabletest"
        }
      },
      "end": "(?=\\|)|$",
      "patterns": [
        { "name": "comment.line.double-slash.tabletest", "match": "//.*$" },
        { "include": "#stringDouble" },
        { "include": "#stringSingle" },
        { "include": "#mapLiteral" },
        { "include": "#listLiteral" },
        { "include": "#setLiteral" },
        { "name": "entity.name.column.tabletest markup.inserted.tabletest.probe.question-header", "match": "[^|\\r\\n]*\\?\\s*" },
        { "name": "entity.name.column.tabletest entity.name.type.tabletest.probe.header", "match": "[^|\\r\\n]+" }
      ]
    },
    "stringDouble": {
      "contentName": "string.quoted.double.tabletest",
      "begin": "\\\"",
      "beginCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "end": "(?<!\\\\)\\\"",
      "endCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tabletest",
          "match": "\\\\."
        }
      ]
    },
    "stringSingle": {
      "contentName": "string.quoted.single.tabletest",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "end": "(?<!\\\\)'",
      "endCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tabletest",
          "match": "\\\\."
        }
      ]
    },
    "listLiteral": {
      "name": "meta.tabletest.list",
      "begin": "\\[(?!(?:[^\\]\"'\\r\\n]|\\\"[^\\\"\\r\\n]*\\\"|'[^'\\r\\n]*')*:)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.tabletest entity.name.type.tabletest.probe"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.tabletest entity.name.type.tabletest.probe"
        }
      },
      "patterns": [
        {
          "name": "constant.numeric.tabletest.separator",
          "match": ","
        },
        {
          "match": "\\s+"
        },
        {
          "include": "#quotedMapKey"
        },
        {
          "include": "#mapLiteral"
        },
        {
          "include": "#listLiteral"
        },
        {
          "include": "#setLiteral"
        },
        {
          "include": "#stringDouble"
        },
        {
          "include": "#stringSingle"
        },
        {
          "name": "string.unquoted.tabletest",
          "match": "[^,\\]\\r\\n]+"
        }
      ]
    },
    "setLiteral": {
      "name": "meta.tabletest.set",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.tabletest entity.name.type.tabletest.probe"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tabletest entity.name.type.tabletest.probe"
        }
      },
      "patterns": [
        {
          "name": "constant.numeric.tabletest.separator",
          "match": ","
        },
        {
          "match": "\\s+"
        },
        {
          "include": "#mapLiteral"
        },
        {
          "include": "#listLiteral"
        },
        {
          "include": "#setLiteral"
        },
        {
          "include": "#stringDouble"
        },
        {
          "include": "#stringSingle"
        },
        {
          "name": "string.unquoted.tabletest",
          "match": "[^,\\}\\r\\n]+"
        }
      ]
    },
    "mapLiteral": {
      "name": "meta.tabletest.map",
      "begin": "\\[(?=(?:[^\\]\"'\\r\\n]|\\\"[^\\\"\\r\\n]*\\\"|'[^'\\r\\n]*')*:)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.tabletest entity.name.type.tabletest.probe"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.tabletest entity.name.type.tabletest.probe"
        }
      },
      "patterns": [
        {
          "name": "constant.numeric.tabletest.separator",
          "match": ","
        },
        {
          "match": "\\s+"
        },
        {
          "include": "#mapLiteral"
        },
        {
          "include": "#listLiteral"
        },
        {
          "include": "#setLiteral"
        },
        {
          "include": "#quotedMapKey"
        },
        {
          "include": "#mapKey"
        },
        {
          "name": "constant.numeric.tabletest.separator",
          "match": ":"
        },
        {
          "include": "#stringDouble"
        },
        {
          "include": "#stringSingle"
        },
        {
          "name": "string.unquoted.tabletest",
          "match": "[^,:\\]\\r\\n]+"
        }
      ]
    },
    "quotedMapKey": {
      "patterns": [
        { "include": "#mapKeyDoubleQuoted" },
        { "include": "#mapKeySingleQuoted" }
      ]
    },
    "mapKeyDoubleQuoted": {
      "contentName": "keyword.control.tabletest",
      "begin": "\\\"(?=(?:\\\\.|[^\\\"\\\\\\r\\n])*\\\"\\s*:)",
      "beginCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "end": "\\\"(?=\\s*:)",
      "endCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tabletest",
          "match": "\\\\."
        }
      ]
    },
    "mapKeySingleQuoted": {
      "contentName": "keyword.control.tabletest",
      "begin": "'(?=(?:\\\\.|[^'\\\\\\r\\n])*'\\s*:)",
      "beginCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "end": "'(?=\\s*:)",
      "endCaptures": {
        "0": {
          "name": "constant.numeric.tabletest.quote"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.tabletest",
          "match": "\\\\."
        }
      ]
    },
    "mapKey": {
      "name": "keyword.control.tabletest",
      "match": "[^,:\\]\\|\\r\\n]+(?=\\s*:)"
    }
  }
}
