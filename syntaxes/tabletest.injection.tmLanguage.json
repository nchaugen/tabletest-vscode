{
  "scopeName": "tabletest.injection",
  "injectionSelector": "L:source.java",
  "patterns": [
    { "include": "#tabletestImplicitAfterAnnotation" },
    { "include": "#tabletestImplicitArrayAfterAnnotation" },
    { "include": "#tabletestAnnotationString" }
  ],
  "repository": {
    "tabletestImplicitAfterAnnotation": {
      "name": "meta.tabletest.block",
      "begin": "(@(?:[\\w$]+\\.)*TableTest)\\s*\\(\\s*(?<!\\\\)(\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "storage.type.annotation.tabletest"
        },
        "2": {
          "name": "punctuation.definition.string.begin.tabletest"
        }
      },
      "end": "(?<!\\\\)(\"\"\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#table" }
      ]
    },
    "tabletestImplicitArrayAfterAnnotation": {
      "name": "meta.tabletest.array",
      "begin": "(@(?:[\\w$]+\\.)*TableTest)\\s*\\(\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.annotation.tabletest"
        },
        "2": {
          "name": "punctuation.section.braces.begin.tabletest"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#tabletestArrayRows" }
      ]
    },
    "tabletestAnnotationString": {
      "begin": "(@(?:[\\w$]+\\.)*TableTest)\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "storage.type.annotation.tabletest"
        }
      },
      "end": "\\)",
      "patterns": [
        { "include": "#tabletestValueArgument" },
        { "include": "#tabletestImplicitValueArray" },
        { "include": "#tabletestImplicitValueString" }
      ]
    },
    "tabletestImplicitValueString": {
      "name": "meta.tabletest.block",
      "begin": "^[ \\t]*(?!\\w+\\s*=)(?<!\\\\)(\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.tabletest"
        }
      },
      "end": "(?<!\\\\)(\"\"\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#table" }
      ]
    },
    "tabletestValueArgument": {
      "name": "meta.tabletest.value-argument",
      "begin": "\\bvalue\\s*=",
      "end": "(?=,|\\))",
      "patterns": [
        { "include": "#tabletestArrayLiteral" },
        { "include": "#tabletestBlock" }
      ]
    },
    "tabletestImplicitValueArray": {
      "name": "meta.tabletest.array",
      "begin": "^[ \\t]*(?!\\w+\\s*=)(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.tabletest"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#tabletestArrayRows" }
      ]
    },
    "tabletestArrayLiteral": {
      "name": "meta.tabletest.array",
      "begin": "(\\{)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.braces.begin.tabletest"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#tabletestArrayRows" }
      ]
    },
    "tabletestArrayRows": {
      "patterns": [
        { "include": "#tabletestArrayHeaderString" },
        { "include": "#tabletestArrayRemainingRows" }
      ]
    },
    "tabletestArrayHeaderString": {
      "name": "markup.heading.tabletest meta.tabletest.header",
      "begin": "\\s*(\\\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.tabletest"
        }
      },
      "end": "(?<!\\\\)(\\\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#tableHeaderInArray" }
      ]
    },
    "tabletestArrayRowString": {
      "name": "meta.tabletest.row",
      "begin": "\\s*(\\\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.tabletest"
        }
      },
      "end": "(?<!\\\\)(\\\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#tableRowInArray" }
      ]
    },
    "tabletestArrayRemainingRows": {
      "name": "meta.tabletest.array.rows",
      "begin": "\\s*,",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.comma.tabletest"
        }
      },
      "end": "(?=\\})",
      "patterns": [
        { "include": "#tabletestArrayRowString" },
        { "name": "punctuation.separator.comma.tabletest", "match": "," }
      ]
    },
    "tableHeaderInArray": {
      "patterns": [
        { "name": "comment.line.double-slash.tabletest", "match": "//.*$" },
        { "include": "#stringDouble" },
        { "include": "#stringSingle" },
        { "match": "\\s+" },
        { "include": "#mapLiteral" },
        { "include": "#listLiteral" },
        { "include": "#setLiteral" },
        { "name": "keyword.operator.tabletest.pipe", "match": "\\|" },
        { "name": "entity.name.column.tabletest", "match": "(?:(?!(?<!\\\\)\\\")[^|\\r\\n])+" }
      ]
    },
    "tableRowInArray": {
      "patterns": [
        { "name": "comment.line.double-slash.tabletest", "match": "//.*$" },
        { "include": "#stringDouble" },
        { "include": "#stringSingle" },
        { "match": "\\s+" },
        { "include": "#mapLiteral" },
        { "include": "#listLiteral" },
        { "include": "#setLiteral" },
        { "name": "keyword.operator.tabletest.pipe", "match": "\\|" },
        { "name": "string.unquoted.tabletest", "match": "(?:(?!(?<!\\\\)\\\")[^|\\r\\n])+" }
      ]
    },
    "tabletestBlock": {
      "name": "meta.tabletest.block",
      "begin": "(?<!\\\\)(\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.tabletest"
        }
      },
      "end": "(?<!\\\\)(\"\"\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.tabletest"
        }
      },
      "patterns": [
        { "include": "#table" }
      ]
    },
    "table": {
      "patterns": [
        { "include": "#tableHeaderRow" },
        { "include": "#tableHeaderRowCrLf" },
        { "include": "#tableRow" }
      ]
    },
    "tableHeaderRow": {
      "name": "markup.heading.tabletest meta.tabletest.header",
      "begin": "(?<=\\\"\\\"\\\"\\n)",
      "end": "(?=(?<!\\\\)\\\"\\\"\\\")|$",
      "patterns": [
        { "include": "#tableHeaderCell" }
      ]
    },
    "tableHeaderRowCrLf": {
      "name": "markup.heading.tabletest meta.tabletest.header",
      "begin": "(?<=\\\"\\\"\\\"\\r\\n)",
      "end": "(?=(?<!\\\\)\\\"\\\"\\\")|$",
      "patterns": [
        { "include": "#tableHeaderCell" }
      ]
    },
    "tableRow": {
      "name": "meta.tabletest.row",
      "begin": "^",
      "end": "(?=(?<!\\\\)\\\"\\\"\\\")|$",
      "patterns": [
        { "include": "#tableCell" }
      ]
    },
    "tableCell": {
      "begin": "(^|\\|)\\s*(?!\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.tabletest.pipe"
        }
      },
      "end": "(?=\\|)|(?=(?<!\\\\)\\\"\\\"\\\")|$",
      "patterns": [
        { "name": "comment.line.double-slash.tabletest", "match": "//.*$" },
        { "include": "#stringDouble" },
        { "include": "#stringSingle" },
        { "include": "#mapLiteral" },
        { "include": "#listLiteral" },
        { "include": "#setLiteral" },
        { "name": "string.unquoted.tabletest", "match": "(?:(?!(?<!\\\\)\\\"\\\"\\\")[^|\\r\\n])+" }
      ]
    },
    "tableHeaderCell": {
      "begin": "(^|\\|)\\s*(?!\"\"\")",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.tabletest.pipe"
        }
      },
      "end": "(?=\\|)|(?=(?<!\\\\)\\\"\\\"\\\")|$",
      "patterns": [
        { "include": "#stringDouble" },
        { "include": "#stringSingle" },
        { "include": "#mapLiteral" },
        { "include": "#listLiteral" },
        { "include": "#setLiteral" },
        { "name": "entity.name.column.tabletest", "match": "(?:(?!(?<!\\\\)\\\"\\\"\\\")[^|\\r\\n])+" }
      ]
    },
    "stringDouble": {
      "name": "string.quoted.double.tabletest",
      "match": "\\\"[^\\\"\\r\\n]*\\\""
    },
    "stringSingle": {
      "name": "string.quoted.single.tabletest",
      "match": "'[^'\\r\\n]*'"
    },
    "listLiteral": {
      "name": "meta.tabletest.list",
      "begin": "\\[(?![^\\]\\r\\n]*:)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.tabletest"
        }
      },
      "end": "(?:\\]|(?=(?<!\\\\)\\\"\\\"\\\"))",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.tabletest"
        }
      },
      "patterns": [
        {
          "name": "punctuation.separator.comma.tabletest",
          "match": ","
        },
        {
          "match": "\\s+"
        },
        {
          "include": "#mapLiteral"
        },
        {
          "include": "#listLiteral"
        },
        {
          "include": "#setLiteral"
        },
        {
          "include": "#stringDouble"
        },
        {
          "include": "#stringSingle"
        },
        {
          "name": "string.unquoted.tabletest",
          "match": "(?:(?!(?<!\\\\)\\\"\\\"\\\")[^,\\]\\r\\n])+"
        }
      ]
    },
    "setLiteral": {
      "name": "meta.tabletest.set",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.tabletest"
        }
      },
      "end": "(?:\\}|(?=(?<!\\\\)\\\"\\\"\\\"))",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.tabletest"
        }
      },
      "patterns": [
        {
          "name": "punctuation.separator.comma.tabletest",
          "match": ","
        },
        {
          "match": "\\s+"
        },
        {
          "include": "#mapLiteral"
        },
        {
          "include": "#listLiteral"
        },
        {
          "include": "#setLiteral"
        },
        {
          "include": "#stringDouble"
        },
        {
          "include": "#stringSingle"
        },
        {
          "name": "string.unquoted.tabletest",
          "match": "(?:(?!(?<!\\\\)\\\"\\\"\\\")[^,\\}\\r\\n])+"
        }
      ]
    },
    "mapLiteral": {
      "name": "meta.tabletest.map",
      "begin": "\\[(?=[^\\]\\r\\n]*:)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.tabletest"
        }
      },
      "end": "(?:\\]|(?=(?<!\\\\)\\\"\\\"\\\"))",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.tabletest"
        }
      },
      "patterns": [
        {
          "name": "punctuation.separator.comma.tabletest",
          "match": ","
        },
        {
          "match": "\\s+"
        },
        {
          "include": "#mapLiteral"
        },
        {
          "include": "#listLiteral"
        },
        {
          "include": "#setLiteral"
        },
        {
          "include": "#mapKey"
        },
        {
          "name": "keyword.operator.assignment.tabletest",
          "match": ":"
        },
        {
          "include": "#stringDouble"
        },
        {
          "include": "#stringSingle"
        },
        {
          "name": "string.unquoted.tabletest",
          "match": "(?:(?!(?<!\\\\)\\\"\\\"\\\")[^,:\\]\\r\\n])+"
        }
      ]
    },
    "mapKey": {
      "name": "support.type.property-name.tabletest",
      "match": "(?:\\\"[^\\\"\\r\\n]*\\\"|'[^'\\r\\n]*'|[^,:\\]\\r\\n]+)(?=\\s*:)"
    }
  }
}
