{
  "name": "tabletest",
  "displayName": "TableTest",
  "description": "IDE support for readable TableTest data-driven tables in Java, Kotlin, and .table files.",
  "icon": "tabletest_128x128.png",
  "version": "0.0.7",
  "publisher": "tabletest",
  "repository": {
    "type": "git",
    "url": "https://github.com/nchaugen/tabletest-vscode.git"
  },
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:kotlin"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Testing",
    "Formatters"
  ],
  "keywords": [
    "tabletest",
    "junit",
    "bdd",
    "tdd",
    "data-driven testing",
    "parameterized tests",
    "table-driven testing",
    "table",
    "formatter",
    "syntax highlighting",
    "java",
    "kotlin"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[tabletest]": {
        "editor.defaultFormatter": "tabletest.tabletest"
      }
    },
    "configuration": {
      "title": "TableTest",
      "properties": {
        "tabletest.format.extraIndentLevel": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "description": "Additional indent levels to add inside formatted Java/Kotlin TableTest triple-quoted strings and Java string-array tables. If not explicitly configured, Java follows formatter continuation indentation (defaulting to 2 levels when profile values are unavailable), while Kotlin aligns with the opening triple quote. Indent width follows editor formatting options (including EditorConfig-applied indentation)."
        }
      }
    },
    "languages": [
      {
        "id": "tabletest",
        "aliases": [
          "TableTest"
        ],
        "extensions": [
          ".table"
        ],
        "configuration": "./language-configuration.tabletest.json"
      }
    ],
    "commands": [
      {
        "command": "tabletest.formatAllTables",
        "title": "TableTest: Format All Tables in Document"
      }
    ],
    "grammars": [
      {
        "language": "tabletest",
        "scopeName": "source.tabletest",
        "path": "./syntaxes/tabletest.tmLanguage.json"
      },
      {
        "scopeName": "tabletest.injection",
        "path": "./syntaxes/tabletest.injection.tmLanguage.json",
        "injectTo": [
          "source.java"
        ]
      },
      {
        "scopeName": "tabletest.kotlin.injection",
        "path": "./syntaxes/tabletest.kotlin.injection.tmLanguage.json",
        "injectTo": [
          "source.kotlin"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "tableHeader",
        "description": "TableTest header cells",
        "superType": "type"
      },
      {
        "id": "tableQuestionHeader",
        "description": "TableTest header cells ending with ?",
        "superType": "property"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "tabletest",
        "scopes": {
          "tableHeader": [
            "entity.name.type.tabletest.probe.header",
            "entity.name.column.tabletest"
          ],
          "tableQuestionHeader": [
            "markup.inserted.tabletest.probe.question-header"
          ]
        }
      },
      {
        "language": "java",
        "scopes": {
          "tableHeader": [
            "entity.name.type.tabletest.probe.header",
            "entity.name.column.tabletest"
          ],
          "tableQuestionHeader": [
            "markup.inserted.tabletest.probe.question-header"
          ]
        }
      },
      {
        "language": "kotlin",
        "scopes": {
          "tableHeader": [
            "entity.name.type.tabletest.probe.header",
            "entity.name.column.tabletest"
          ],
          "tableQuestionHeader": [
            "markup.inserted.tabletest.probe.question-header"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "release:prepare": "node ./scripts/prepare-release.cjs",
    "release:notes": "node ./scripts/extract-release-notes.cjs",
    "test": "npm run test:unit",
    "test:unit": "npm run test:formatter && npm run test:grammar",
    "test:formatter": "tsc -p tsconfig.tests.json && node --test out-tests/tests/*.test.js",
    "test:integration": "npm run compile && node ./out/test/runTest.js",
    "test:integration:strict": "node ./scripts/run-integration-strict.cjs",
    "test:full": "node ./scripts/run-full-tests.cjs",
    "test:grammar": "vscode-tmgrammar-test -g ./syntaxes/tabletest.injection.tmLanguage.json -g ./syntaxes/tabletest.kotlin.injection.tmLanguage.json -g ./syntaxes/tabletest.tmLanguage.json \"tests/grammar/**/*.syntax\"",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^25.5.0",
    "@types/mocha": "^10.0.7",
    "@vscode/test-electron": "^2.4.1",
    "typescript": "^5.4.0",
    "eslint": "^10.0.3",
    "@typescript-eslint/parser": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@vscode/vsce": "^3.0.0",
    "mocha": "^11.7.5",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
